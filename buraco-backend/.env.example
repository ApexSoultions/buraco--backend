# Copy to .env and fill in. Never commit .env.
# [required] = the server will not work (or, in production, will not start) without it.
# Values shown are for local development unless marked "live".

# ── App ──────────────────────────────────────────────────────────────────────
# live: production — turns on the startup secret check below
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (admin panel). Empty = any.
CORS_ORIGINS=
# API docs page at "/". Keep true while the client is being built; false for release.
SWAGGER_ENABLED=true

# ── Database / Redis ─────────────────────────────────────────────────────────
# [required]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buraco_db
# [required]
REDIS_URL=redis://localhost:6379

# ── Login tokens ─────────────────────────────────────────────────────────────
# [required] Three DIFFERENT random values, 32+ characters each. In production the
# server refuses to start if one is missing, short, shared or still "change-me…".
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing them logs every player out once.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=change-me-admin-secret
ADMIN_JWT_EXPIRES_IN=8h

# ── Google / Apple sign-in (optional until those logins are used) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── AWS S3: avatars (public) and voice messages (private, signed links) ──────
# [required for voice messages and avatars]
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=buraco-game-assets

# ── Email: password reset (optional until password reset is used) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@buraco.game

# ── Push notifications (optional; empty = in-app notifications only) ─────────
FCM_SERVER_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Window in seconds. Signed-in limits count per player, signed-out ones per IP.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_ANON_LIMIT=60
# Chat messages per player in any 10 seconds (socket chat:send)
THROTTLE_CHAT_PER_10S=10

# ── Game ─────────────────────────────────────────────────────────────────────
DISCONNECT_TIMEOUT_SECONDS=60
DEFAULT_TURN_DURATION=30
NEW_USER_COINS=1000
NEW_USER_DIAMONDS=0
NEW_USER_LIVES=5

# QA socket event `game:debug:force_round` (jumps a live match to a later round).
# OFF unless true. Use true only on your own PC or a test server — live: false.
DEBUG_GAME_EVENTS=false
